<Window x:Class="ClipShelf.App.Settings.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Impostazioni · ClipShelf">
  <ScrollViewer><StackPanel x:Name="Root" Padding="28" Spacing="18" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <TextBlock Text="Impostazioni" FontSize="26" FontWeight="SemiBold"/>
    <TextBlock Text="Scorciatoia globale" FontWeight="SemiBold"/>
    <StackPanel Orientation="Horizontal" Spacing="12"><ComboBox x:Name="Modifiers" SelectedIndex="0"><ComboBoxItem Content="Ctrl + Shift"/><ComboBoxItem Content="Ctrl + Alt"/><ComboBoxItem Content="Alt + Shift"/></ComboBox><TextBox x:Name="Letter" Text="V" MaxLength="1" Width="72" Header="Lettera A–Z"/></StackPanel>
    <ToggleSwitch x:Name="Pause" Header="Cattura degli appunti" OffContent="In pausa" OnContent="Attiva"/>
    <ToggleSwitch x:Name="AutoStart" Header="Avvia all'accesso a Windows" OffContent="Disattivato" OnContent="Attivato"/>
    <TextBlock x:Name="StartupHint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <TextBlock Text="La cronologia salva testo e immagini su questo dispositivo, fino a 200 elementi. I preferiti vengono conservati. Puoi sospendere la cattura quando copi dati sensibili." TextWrapping="Wrap"/>
    <InfoBar x:Name="Status" IsOpen="False" IsClosable="True" Severity="Informational"/>
    <TextBlock Text="Le modifiche si applicano premendo Salva impostazioni." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <Button x:Name="SaveButton" Content="Salva impostazioni" Style="{StaticResource AccentButtonStyle}" Click="Save_Click"/>
    <TextBlock x:Name="DataPathLabel" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <Button Content="Ripristina una cronologia danneggiata…" Click="Recover_Click"/>
  </StackPanel></ScrollViewer>
</Window>
