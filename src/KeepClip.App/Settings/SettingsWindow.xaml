<Window x:Class="KeepClip.App.Settings.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Impostazioni · KeepClip">
  <Grid x:Name="Root" Background="{ThemeResource KeepClipPageBrush}">
    <Grid.Resources><ResourceDictionary Source="ms-appx:///Appearance/ThemeResources.xaml"/></Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Padding="28" Spacing="18">
    <TextBlock Text="Impostazioni" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource KeepClipTextBrush}"/>
    <Border BorderBrush="{ThemeResource KeepClipBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,16">
      <StackPanel Spacing="8">
        <TextBlock Text="Diagnostica" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource KeepClipTextBrush}"/>
        <TextBlock Text="Salva gli eventi recenti, i nomi delle app e i codici di errore in un file di testo da allegare a una segnalazione. Il file esclude il contenuto degli appunti." TextWrapping="Wrap" Foreground="{ThemeResource KeepClipSecondaryTextBrush}"/>
        <Button x:Name="ExportLogsButton" Content="Esporta log…" Click="ExportLogs_Click"/>
      </StackPanel>
    </Border>
    <Border Background="{ThemeResource KeepClipSurfaceBrush}" BorderBrush="{ThemeResource KeepClipBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
      <StackPanel Spacing="14">
        <TextBlock Text="Editor del tema" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource KeepClipTextBrush}"/>
        <ComboBox x:Name="ThemeChoice" Header="Modalità" HorizontalAlignment="Stretch" SelectionChanged="Appearance_Changed">
          <ComboBoxItem Content="Sistema"/><ComboBoxItem Content="Chiaro"/><ComboBoxItem Content="Scuro"/>
        </ComboBox>
        <TextBlock Text="Palette predefinite" FontWeight="SemiBold" Foreground="{ThemeResource KeepClipTextBrush}"/>
        <Grid x:Name="PaletteChoices" RowSpacing="8" ColumnSpacing="8">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        </Grid>
        <CheckBox x:Name="ColorSurfaces" Content="Colora anche sfondo e header delle card" Click="Appearance_Changed"/>
        <TextBlock Text="Anteprima" FontSize="12" Foreground="{ThemeResource KeepClipSecondaryTextBrush}"/>
        <Border BorderBrush="{ThemeResource KeepClipBorderBrush}" BorderThickness="1" Background="{ThemeResource KeepClipPageBrush}" CornerRadius="10" Padding="14">
          <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Background="{ThemeResource KeepClipSurfaceBrush}" BorderBrush="{ThemeResource KeepClipBorderBrush}" BorderThickness="1" CornerRadius="8">
              <StackPanel>
                <Border Background="{ThemeResource KeepClipHeaderBrush}" CornerRadius="7,7,0,0" Padding="12">
                  <StackPanel Orientation="Horizontal" Spacing="10"><Image Source="ms-appx:///Assets/AppLogo.png" Width="32" Height="32"/><TextBlock Text="KeepClip" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource KeepClipHeaderTextBrush}"/></StackPanel>
                </Border>
                <StackPanel Padding="12" Spacing="6"><TextBlock Text="Esempio di testo copiato." TextWrapping="Wrap" Foreground="{ThemeResource KeepClipTextBrush}"/><TextBlock Text="Testo · Adesso" FontSize="11" Foreground="{ThemeResource KeepClipAccentTextBrush}"/></StackPanel>
              </StackPanel>
            </Border>
            <Button Grid.Column="1" Content="Incolla" IsTabStop="False" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" AutomationProperties.Name="Anteprima del colore del pulsante Incolla"/>
          </Grid>
        </Border>
        <TextBlock Text="L'anteprima modifica queste impostazioni. Salva per applicare il tema alla cronologia." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource KeepClipSecondaryTextBrush}"/>
        <Button Content="Ripristina tema predefinito" Click="ResetTheme_Click"/>
      </StackPanel>
    </Border>
    <ToggleSwitch x:Name="WindowsVShortcut" Header="Usa Win+V per aprire KeepClip" OffContent="Windows" OnContent="KeepClip"/>
    <TextBlock Text="Disattiva l’opzione e salva per restituire Win+V a Windows." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource KeepClipSecondaryTextBrush}"/>
    <TextBlock Text="Scorciatoia alternativa" FontWeight="SemiBold" Foreground="{ThemeResource KeepClipTextBrush}"/>
    <StackPanel Orientation="Horizontal" Spacing="12"><ComboBox x:Name="Modifiers" SelectedIndex="0"><ComboBoxItem Content="Ctrl + Shift"/><ComboBoxItem Content="Ctrl + Alt"/><ComboBoxItem Content="Alt + Shift"/></ComboBox><TextBox x:Name="Letter" Text="V" MaxLength="1" Width="72" Header="Lettera A–Z"/></StackPanel>
    <ToggleSwitch x:Name="Pause" Header="Cattura degli appunti" OffContent="In pausa" OnContent="Attiva"/>
    <ToggleSwitch x:Name="CopySelection" Header="Copia alla selezione" OffContent="Disattivata" OnContent="Attiva"/>
    <TextBlock Text="Copia il testo al rilascio del mouse quando viene riconosciuto come non modificabile. Esclude campi di input, editor, password e KeepClip, così puoi selezionare testo da sostituire senza perdere gli appunti. Nei campi di input o nei controlli non riconosciuti usa Ctrl+C; si sospende quando la cattura è in pausa." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource KeepClipSecondaryTextBrush}"/>
    <ToggleSwitch x:Name="CopySound" Header="Suono di conferma copia" OffContent="Disattivato" OnContent="Attivo"/>
    <StackPanel Spacing="8">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="Volume del suono" Foreground="{ThemeResource KeepClipTextBrush}"/>
        <TextBlock x:Name="SoundVolumeLabel" Grid.Column="1" Text="50%" Foreground="{ThemeResource KeepClipTextBrush}"/>
      </Grid>
      <Slider x:Name="SoundVolume" Minimum="0" Maximum="100" Value="50" StepFrequency="1" TickFrequency="25" AutomationProperties.Name="Volume del suono di copia" ValueChanged="SoundVolume_Changed"/>
      <Button Content="Prova suono" Click="PreviewSound_Click"/>
    </StackPanel>
    <ToggleSwitch x:Name="AutoStart" Header="Avvia all'accesso a Windows" OffContent="Disattivato" OnContent="Attivato"/>
    <TextBlock x:Name="StartupHint" TextWrapping="Wrap" Foreground="{ThemeResource KeepClipSecondaryTextBrush}"/>
    <TextBlock Text="La cronologia salva testo, immagini e riferimenti a file e cartelle su questo dispositivo, fino a 200 elementi. I preferiti vengono conservati. Puoi sospendere la cattura quando copi dati sensibili." TextWrapping="Wrap" Foreground="{ThemeResource KeepClipTextBrush}"/>
    <TextBlock x:Name="DataPathLabel" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource KeepClipSecondaryTextBrush}"/>
    <Button Content="Ripristina una cronologia danneggiata…" Click="Recover_Click"/>
  </StackPanel></ScrollViewer>
  <Border Grid.Row="1" Padding="28,16" Background="{ThemeResource KeepClipSurfaceBrush}" BorderBrush="{ThemeResource KeepClipBorderBrush}" BorderThickness="0,1,0,0">
    <StackPanel Spacing="10"><InfoBar x:Name="Status" IsOpen="False" IsClosable="True" Severity="Informational"/>
      <TextBlock Text="Le modifiche si applicano premendo Salva impostazioni." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource KeepClipSecondaryTextBrush}"/>
      <Button x:Name="SaveButton" Content="Salva impostazioni" Style="{StaticResource AccentButtonStyle}" Click="Save_Click"/>
    </StackPanel>
  </Border>
  </Grid>
</Window>
