<UserControl x:Class="KeepClip.App.Shelf.ClipCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Width="244" Height="232" Background="{ThemeResource KeepClipSurfaceBrush}" BorderBrush="{ThemeResource KeepClipBorderBrush}" BorderThickness="1" CornerRadius="10">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Background="{ThemeResource KeepClipHeaderBrush}" CornerRadius="9,9,0,0" Padding="14,12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource KeepClipBorderBrush}">
        <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <FontIcon x:Name="SourceFallback" Glyph="&#xE737;" FontSize="32" Foreground="{ThemeResource KeepClipHeaderTextBrush}"/>
          <Image x:Name="SourceIcon" Width="40" Height="40" Stretch="Uniform"/>
          <TextBlock x:Name="SourceName" Grid.Column="1" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource KeepClipHeaderTextBrush}"/>
          <TextBlock x:Name="PinLabel" Grid.Column="2" Text="★" VerticalAlignment="Center" Foreground="{ThemeResource KeepClipHeaderTextBrush}"/>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="14,12"><TextBlock x:Name="PreviewText" FontSize="14" TextWrapping="Wrap" MaxLines="5" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource KeepClipTextBrush}"/><Image x:Name="PreviewImage" Stretch="Uniform"/></Grid>
      <Grid Grid.Row="2" Margin="14,0,14,12">
        <TextBlock x:Name="KindLabel" FontWeight="SemiBold" FontSize="10" Foreground="{ThemeResource KeepClipAccentTextBrush}"/>
        <TextBlock x:Name="TimeLabel" HorizontalAlignment="Right" FontSize="11" Foreground="{ThemeResource KeepClipSecondaryTextBrush}"/>
      </Grid>
    </Grid>
  </Border>
</UserControl>
