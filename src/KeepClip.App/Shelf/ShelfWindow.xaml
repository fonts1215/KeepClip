<Window x:Class="KeepClip.App.Shelf.ShelfWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:KeepClip.App.Shelf" Title="KeepClip">
  <Grid x:Name="Root" Background="{ThemeResource KeepClipPageBrush}" Padding="24,18" RowSpacing="12" KeyDown="Root_KeyDown">
    <Grid.Resources><ResourceDictionary Source="ms-appx:///Appearance/ThemeResources.xaml"/></Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Image Source="ms-appx:///Assets/AppLogo.png" Width="32" Height="32" Stretch="Uniform" AutomationProperties.AccessibilityView="Raw"/><TextBlock Text="KeepClip" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource KeepClipTextBrush}"/></StackPanel>
      <TextBox x:Name="Search" Grid.Column="1" PlaceholderText="Cerca nella cronologia…" Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="480" HorizontalAlignment="Stretch"/>
      <ToggleButton Grid.Column="2" Content="★ Preferiti" IsChecked="{Binding ShowPinnedOnly, Mode=TwoWay}"/>
      <Button Grid.Column="3" Click="Settings_Click" AutomationProperties.Name="Impostazioni"><FontIcon Glyph="&#xE713;"/></Button>
    </Grid>
    <InfoBar x:Name="Status" Grid.Row="1" IsOpen="False" Severity="Informational" IsClosable="True"/>
    <Grid Grid.Row="2">
      <GridView x:Name="Cards" Height="260" Padding="0" VerticalAlignment="Top" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Cards_ItemClick" DoubleTapped="Cards_DoubleTapped" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,12,0"/><Setter Property="VerticalAlignment" Value="Top"/></Style></GridView.ItemContainerStyle>
        <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Vertical" MaximumRowsOrColumns="1"/></ItemsPanelTemplate></GridView.ItemsPanel>
        <GridView.ItemTemplate><DataTemplate><local:ClipCard/></DataTemplate></GridView.ItemTemplate>
      </GridView>
      <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"><FontIcon Glyph="&#xE8C8;" FontSize="30" Foreground="{ThemeResource KeepClipAccentTextBrush}"/><TextBlock x:Name="EmptyText" Text="Copia qualcosa per iniziare" FontSize="18" Foreground="{ThemeResource KeepClipTextBrush}"/><TextBlock Text="Testo, immagini e file saranno disponibili qui." Foreground="{ThemeResource KeepClipSecondaryTextBrush}"/></StackPanel>
    </Grid>
    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Incolla" Style="{StaticResource AccentButtonStyle}" Click="Paste_Click"/><Button Content="★ Preferito" Click="Pin_Click"/><Button Content="Elimina" Click="Delete_Click"/><Button Content="Svuota…" Click="Clear_Click"/></StackPanel>
      <TextBlock x:Name="CountLabel" Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource KeepClipSecondaryTextBrush}"/>
    </Grid>
  </Grid>
</Window>
